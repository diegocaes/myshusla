---
import { ArrowLeft, ShoppingCart, Check, Truck, Shield } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProductCard from '../../components/ProductCard.astro';
import Contact from '../../components/Contact.astro';
import { products, getProductById } from '../../data/products';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return products.map(product => ({
    params: { id: product.id },
  }));
}

const { id } = Astro.params;
const product = getProductById(id!);

if (!product) {
  return Astro.redirect('/store');
}

// Calcular porcentaje de descuento
const discountPercent = product.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : 0;

// Crear link de WhatsApp
const whatsappMessage = product.whatsappMessage ||
  `Hola! Me interesa comprar ${product.name} que vi en myshusla.com/store/${product.id}`;
const whatsappLink = `https://wa.me/${siteConfig.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(whatsappMessage)}`;

// Productos relacionados (misma categoría, excluyendo el actual)
const relatedProducts = products
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 3);
---

<Layout
  title={`${product.name} | Tienda MyShus`}
  description={product.description}
  keywords={`${product.name}, comprar ${product.name} Panamá, ${product.category === 'care' ? 'cuidado zapatillas' : 'accesorios zapatillas'} Panamá`}
>
  <Navbar />

  <!-- Breadcrumb -->
  <section class="breadcrumb">
    <div class="container">
      <a href="/store" class="back-link">
        <ArrowLeft size={20} />
        <span>Volver a la tienda</span>
      </a>
    </div>
  </section>

  <!-- Product Detail -->
  <section class="product-detail">
    <div class="container">
      <div class="product-grid">
        <!-- Image Gallery -->
        <div class="image-section">
          {discountPercent > 0 && (
            <div class="discount-badge-large">
              <span>-{discountPercent}%</span>
            </div>
          )}

          <div class="main-image">
            <img
              src={product.images[0]}
              alt={product.name}
              loading="eager"
            />
          </div>

          {product.images.length > 1 && (
            <div class="thumbnail-gallery">
              {product.images.map((image, index) => (
                <div class="thumbnail">
                  <img src={image} alt={`${product.name} - vista ${index + 1}`} />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Product Info -->
        <div class="info-section">
          {!product.inStock && (
            <div class="out-of-stock-notice">
              Agotado - Te notificaremos cuando llegue
            </div>
          )}

          <h1 class="product-title">{product.name}</h1>

          <p class="product-description">{product.description}</p>

          <!-- Pricing -->
          <div class="pricing-section">
            {product.originalPrice && (
              <span class="original-price">${product.originalPrice}</span>
            )}
            <span class="current-price">${product.price}</span>
            {discountPercent > 0 && (
              <span class="savings-text">Ahorras ${product.originalPrice! - product.price}</span>
            )}
          </div>

          <!-- Trust Badges -->
          <div class="trust-badges">
            <div class="badge">
              <Truck size={20} />
              <span>Envío gratis +$30</span>
            </div>
            <div class="badge">
              <Shield size={20} />
              <span>Garantía de calidad</span>
            </div>
          </div>

          <!-- CTA Button -->
          {product.inStock ? (
            <a href={whatsappLink} target="_blank" class="buy-button-large">
              <ShoppingCart size={24} />
              <span>Comprar por WhatsApp</span>
            </a>
          ) : (
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hola! Quiero que me notifiquen cuando ${product.name} esté disponible`)}`}
              target="_blank"
              class="notify-button"
            >
              Notificarme cuando llegue
            </a>
          )}

          <!-- Features -->
          <div class="features-section">
            <h3>Características</h3>
            <ul class="features-list">
              {product.features.map(feature => (
                <li>
                  <Check size={18} />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Extended Description & Specs -->
      <div class="extended-info">
        <div class="info-card">
          <h2>Descripción Completa</h2>
          <p>{product.longDescription}</p>
        </div>

        {product.specs && Object.keys(product.specs).length > 0 && (
          <div class="info-card">
            <h2>Especificaciones</h2>
            <table class="specs-table">
              {Object.entries(product.specs).map(([key, value]) => (
                <tr>
                  <td class="spec-label">{key}</td>
                  <td class="spec-value">{value}</td>
                </tr>
              ))}
            </table>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2 class="section-title">También te puede interesar</h2>
        <div class="related-grid">
          {relatedProducts.map(relatedProduct => (
            <ProductCard product={relatedProduct} />
          ))}
        </div>
      </div>
    </section>
  )}

  <Contact />

  <!-- Structured Data for SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": product.name,
    "description": product.description,
    "image": product.images.map(img => `https://myshusla.com${img}`),
    "brand": {
      "@type": "Brand",
      "name": "MyShus"
    },
    "offers": {
      "@type": "Offer",
      "url": `https://myshusla.com/store/${product.id}`,
      "priceCurrency": "USD",
      "price": product.price,
      "priceValidUntil": "2025-12-31",
      "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "seller": {
        "@type": "Organization",
        "name": "MyShus"
      }
    }
  })} />
</Layout>

<style>
  .breadcrumb {
    background: var(--background-light);
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast) var(--transition-easing);
  }

  .back-link:hover {
    color: var(--accent-gold);
  }

  /* Product Detail */
  .product-detail {
    padding: var(--spacing-2xl) var(--spacing-lg);
    background: var(--background-white);
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-2xl);
  }

  /* Image Section */
  .image-section {
    position: relative;
  }

  .discount-badge-large {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    background: var(--gradient-green);
    color: #FFFFFF;
    padding: 0.75rem 1.25rem;
    border-radius: var(--border-radius);
    font-size: 1.25rem;
    font-weight: 700;
    box-shadow: var(--glow-green);
    z-index: 2;
  }

  .main-image {
    width: 100%;
    aspect-ratio: 1;
    background: var(--background-light);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    border: 2px solid var(--border-color);
  }

  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .thumbnail {
    aspect-ratio: 1;
    background: var(--background-light);
    border-radius: var(--border-radius);
    overflow: hidden;
    border: 2px solid var(--border-color);
    cursor: pointer;
    transition: border-color var(--transition-fast) var(--transition-easing);
  }

  .thumbnail:hover {
    border-color: var(--accent-gold);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Info Section */
  .info-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .out-of-stock-notice {
    background: rgba(255, 107, 53, 0.1);
    color: var(--accent-orange);
    padding: var(--spacing-md);
    border-radius: var(--border-radius);
    font-weight: 600;
    text-align: center;
  }

  .product-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .product-description {
    font-size: 1rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }

  /* Pricing */
  .pricing-section {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--border-color-light);
    border-bottom: 1px solid var(--border-color-light);
  }

  .original-price {
    font-size: 1.25rem;
    color: var(--color-text-lighter);
    text-decoration: line-through;
  }

  .current-price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .savings-text {
    font-size: 0.875rem;
    color: var(--accent-gold);
    font-weight: 600;
    background: rgba(37, 211, 102, 0.1);
    padding: 0.375rem 0.75rem;
    border-radius: var(--border-radius-sm);
  }

  /* Trust Badges */
  .trust-badges {
    display: flex;
    gap: var(--spacing-md);
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--background-light);
    border-radius: var(--border-radius);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .badge :global(svg) {
    color: var(--accent-gold);
  }

  /* CTA Buttons */
  .buy-button-large {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: var(--gradient-olive);
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--border-radius);
    box-shadow: var(--glow-green);
    transition: all var(--transition-fast) var(--transition-easing);
  }

  .buy-button-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
  }

  .notify-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    background: var(--background-carbon);
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all var(--transition-fast) var(--transition-easing);
  }

  .notify-button:hover {
    background: #333333;
  }

  /* Features */
  .features-section h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-md) 0;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .features-list li :global(svg) {
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Extended Info */
  .extended-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }

  .info-card {
    background: var(--background-light);
    padding: var(--spacing-xl);
    border-radius: var(--border-radius-lg);
  }

  .info-card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-md) 0;
  }

  .info-card p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
  }

  /* Specs Table */
  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }

  .specs-table tr {
    border-bottom: 1px solid var(--border-color-light);
  }

  .specs-table tr:last-child {
    border-bottom: none;
  }

  .specs-table td {
    padding: var(--spacing-md) 0;
  }

  .spec-label {
    font-weight: 600;
    color: var(--color-text-light);
    width: 40%;
  }

  .spec-value {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Related Products */
  .related-section {
    padding: var(--spacing-2xl) var(--spacing-lg);
    background: var(--background-color);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-xl) 0;
    text-align: center;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .extended-info {
      grid-template-columns: 1fr;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 768px) {
    .product-detail,
    .related-section {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .product-title {
      font-size: 1.375rem;
    }

    .product-description {
      font-size: 0.9375rem;
    }

    .current-price {
      font-size: 1.75rem;
    }

    .original-price {
      font-size: 1.125rem;
    }

    .trust-badges {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .badge {
      padding: 0.625rem 0.875rem;
      font-size: 0.8125rem;
    }

    .buy-button-large,
    .notify-button {
      width: 100%;
      padding: 0.875rem 1.5rem;
      font-size: 0.9375rem;
    }

    .features-section h3 {
      font-size: 1rem;
    }

    .features-list li {
      font-size: 0.8125rem;
    }

    .info-card {
      padding: var(--spacing-lg);
    }

    .info-card h2 {
      font-size: 1.125rem;
    }

    .info-card p {
      font-size: 0.875rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
