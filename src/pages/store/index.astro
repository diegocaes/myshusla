---
import { Store } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProductCard from '../../components/ProductCard.astro';
import Contact from '../../components/Contact.astro';
import { products } from '../../data/products';
---

<Layout
  title="Tienda MyShus | Productos para el Cuidado de Zapatillas"
  description="Compra productos profesionales para el cuidado de tus zapatillas: hormas de cedro, sílica gel, kits de limpieza y más. Envío a toda Panamá."
  keywords="tienda zapatillas Panamá, hormas cedro, sílica gel, kit limpieza zapatillas, productos cuidado calzado"
>
  <Navbar />

  <!-- Compact Hero Section -->
  <section class="store-hero">
    <div class="hero-container">
      <div class="hero-badge">
        <Store size={20} />
        <span>TIENDA MYSHUS</span>
      </div>
      <h1 class="hero-title">Productos Esenciales para tus Zapatillas</h1>
      <p class="hero-subtitle">
        Protección profesional para zapatillas en Panamá | Envío gratis en compras +$25
      </p>
    </div>
  </section>

  <!-- Main Products Grid -->
  <section class="products-main">
    <div class="products-container">
      <div class="products-grid">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Info Banner -->
  <section class="info-banner">
    <div class="banner-container">
      <h2>¿Cómo Funciona?</h2>
      <div class="steps">
        <div class="step">
          <span class="step-number">1</span>
          <p>Haz clic en "Comprar" del producto que te interesa</p>
        </div>
        <div class="step">
          <span class="step-number">2</span>
          <p>Se abrirá WhatsApp con un mensaje pre-escrito</p>
        </div>
        <div class="step">
          <span class="step-number">3</span>
          <p>Coordina entrega y pago con nuestro equipo</p>
        </div>
      </div>
      <p class="coming-soon">
        🚀 <strong>Próximamente:</strong> Checkout directo, pagos en línea y más productos
      </p>
    </div>
  </section>

  <Contact />
</Layout>

<style>
  /* Compact Hero Section */
  .store-hero {
    background: linear-gradient(135deg, #000000 0%, #1a1a1a 100%);
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
    text-align: center;
    border-bottom: 3px solid var(--accent-gold);
  }

  .hero-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gradient-green);
    color: #FFFFFF;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
    box-shadow: var(--glow-green);
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 var(--spacing-sm) 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    line-height: 1.5;
  }

  /* Main Products Section */
  .products-main {
    padding: var(--spacing-2xl) var(--spacing-lg);
    background: var(--background-white);
  }

  .products-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
  }

  /* Info Banner */
  .info-banner {
    background: linear-gradient(135deg, var(--background-carbon) 0%, #1a1a1a 100%);
    padding: var(--spacing-2xl) var(--spacing-lg);
    color: var(--color-secondary);
  }

  .banner-container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .banner-container h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-xl) 0;
    color: var(--color-secondary);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .step {
    text-align: center;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--gradient-green);
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    box-shadow: var(--glow-green);
  }

  .step p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  .coming-soon {
    background: rgba(255, 235, 59, 0.1);
    border: 1px solid var(--neon-yellow);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--border-radius);
    font-size: 0.9375rem;
    color: var(--neon-yellow);
    margin: 0;
  }

  .coming-soon strong {
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 768px) {
    .store-hero {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .hero-badge {
      font-size: 0.75rem;
      padding: 0.4rem 1rem;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 0.875rem;
    }

    .products-main,
    .info-banner {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
