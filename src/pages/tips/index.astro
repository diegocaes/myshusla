---
import { BookOpen } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Contact from '../../components/Contact.astro';

const blogPosts = [
  {
    title: "Cómo Cuidar tus Zapatillas en la Época de Lluvias en Panamá",
    description: "Guía completa para proteger tus zapatillas de la humedad y las lluvias en Panamá. Consejos de impermeabilización, secado y limpieza profesional.",
    slug: "cuidado-zapatillas-humedad-panama",
    publishDate: "2024-11-01",
    readingTime: "4 min de lectura",
    category: "Clima Tropical"
  },
  {
    title: "Por Qué No Deberías Lavar Tus Zapatillas en la Lavadora",
    description: "Descubre por qué lavar tus zapatillas en la lavadora puede dañarlas permanentemente y qué alternativas existen para mantenerlas impecables.",
    slug: "por-que-no-lavar-zapatillas-lavadora",
    publishDate: "2025-01-15",
    readingTime: "3 min de lectura",
    category: "Cuidado de Zapatillas"
  }
];
---

<Layout
  title="Tips de Cuidado de Zapatillas | MyShus Blog"
  description="Consejos profesionales para el cuidado y mantenimiento de tus zapatillas. Aprende cómo mantener tu calzado en perfectas condiciones."
  keywords="cuidado zapatillas, tips limpieza zapatillas, mantenimiento calzado, consejos zapatillas"
>
  <Navbar />
  <section class="blog-index">
    <div class="blog-container">
      <header class="blog-header">
        <div class="header-icon">
          <BookOpen size={40} />
        </div>
        <h1 class="page-title">Tips y Consejos</h1>
        <p class="page-subtitle">
          Guías profesionales para el cuidado y mantenimiento de tus zapatillas
        </p>
      </header>

      <div class="posts-grid">
        {blogPosts.map((post) => (
          <article class="post-card">
            <div class="post-category">{post.category}</div>
            <h2 class="post-title">
              <a href={`/tips/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="post-description">{post.description}</p>
            <div class="post-meta">
              <time datetime={post.publishDate}>
                {new Date(post.publishDate).toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span class="meta-separator">•</span>
              <span>{post.readingTime}</span>
            </div>
            <a href={`/tips/${post.slug}`} class="read-more">
              Leer más →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Contact />
</Layout>

<style>
  .blog-index {
    min-height: 100vh;
    background-color: var(--background-white);
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .header-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: var(--gradient-green);
    border-radius: 50%;
    color: #FFFFFF;
    margin-bottom: var(--spacing-md);
    box-shadow: var(--glow-green);
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-sm) 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--spacing-xl);
  }

  .post-card {
    background: var(--background-white);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    transition: all var(--transition-speed) var(--transition-easing);
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--glow-green);
    border-color: var(--accent-gold);
  }

  .post-category {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-gold);
    background: rgba(37, 211, 102, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: var(--border-radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-sm);
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.3;
  }

  .post-title a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast) var(--transition-easing);
  }

  .post-title a:hover {
    color: var(--accent-gold);
  }

  .post-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-light);
    margin: 0 0 var(--spacing-md) 0;
    flex: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-lighter);
    margin-bottom: var(--spacing-md);
  }

  .meta-separator {
    color: var(--color-text-lighter);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--transition-fast) var(--transition-easing);
    gap: 0.25rem;
  }

  .read-more:hover {
    gap: 0.5rem;
    text-shadow: 0 0 8px rgba(37, 211, 102, 0.3);
  }

  @media (max-width: 768px) {
    .blog-index {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .header-icon {
      width: 64px;
      height: 64px;
    }

    .header-icon :global(svg) {
      width: 32px;
      height: 32px;
    }

    .page-subtitle {
      font-size: 1.125rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .post-card {
      padding: var(--spacing-lg);
    }

    .post-title {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-title a,
    .read-more {
      transition: none;
    }

    .post-card:hover {
      transform: none;
    }

    .read-more:hover {
      gap: 0;
    }
  }
</style>
