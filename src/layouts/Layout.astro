---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "MyShus - Limpieza de Zapatillas Panamá | Servicio a Domicilio",
  description = "Limpieza profesional de zapatillas en Panamá. Servicio de lavado y restauración de zapatos a domicilio. Recogida y entrega gratis en Panamá Ciudad.",
  keywords = "limpieza de zapatillas Panamá, limpieza de zapatos a domicilio Panamá, servicio de limpieza de zapatillas Panamá, lavado de zapatillas Panamá, restauración de zapatos Panamá, limpieza profesional calzado Panamá Ciudad"
} = Astro.props;

// src/layouts/Layout.astro
const GA_TRACKING_ID = "G-JESF85NFZ1"; // Tu ID de Google Analytics
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="MyShus" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="PA" />
    <meta name="geo.placename" content="Panama City" />
    <meta name="geo.position" content="8.9824;-79.5199" />
    <meta name="ICBM" content="8.9824, -79.5199" />

    <link rel="canonical" href="https://myshusla.com/" />

    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://myshusla.com/images/preview-image.png" />
    <meta property="og:url" content="https://myshusla.com" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://myshusla.com/images/preview-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}></script>
    <script is:inline define:vars={{ GA_TRACKING_ID }}>
      window.dataLayer = window.dataLayer || [];
      // Usamos 'arguments' directamente, es la forma más común y robusta para gtag.
      // Astro procesará este script y lo incluirá tal cual en el HTML final.
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_TRACKING_ID);
    </script>

    <!-- Structured Data for Local Business -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "MyShus",
        "description": "Servicio profesional de limpieza, lavado y restauración de zapatillas y zapatos en Panamá. Especialistas en limpieza de calzado deportivo y de lujo con servicio de recogida y entrega a domicilio.",
        "url": "https://myshusla.com",
        "telephone": "+507-6443-9110",
        "areaServed": {
          "@type": "Country",
          "name": "Panama"
        },
        "serviceType": ["Sneaker Cleaning Service", "Shoe Cleaning", "Footwear Restoration", "Limpieza de Zapatillas", "Lavado de Zapatos"],
        "openingHours": [
          "Mo-Fr 08:00-16:30"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de Limpieza",
          "itemListElement": [
            {
              "@type": "Offer",
              "name": "Limpieza Sencilla",
              "description": "Limpieza externa (upper, suela, y midsole). Eliminación de suciedad superficial.",
              "price": "18",
              "priceCurrency": "USD"
            },
            {
              "@type": "Offer", 
              "name": "Limpieza Completa",
              "description": "Limpieza externa + interna (plantillas y forros interiores). Cordones y eliminación de malos olores.",
              "price": "25",
              "priceCurrency": "USD"
            }
          ]
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+507-6443-9110",
          "contactType": "Customer Service",
          "availableLanguage": "Spanish"
        },
        "sameAs": [
          "https://www.instagram.com/myshusla",
          "https://wa.me/+50764439110"
        ]
      }
    </script>
  </head>

  <body>
    <slot />
    <WhatsAppButton />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const lazyImages = document.querySelectorAll("img[data-src]");
        lazyImages.forEach((img) => {
          const imageEl = img as HTMLImageElement; // Type assertion para TypeScript
          const dataSrc = imageEl.getAttribute("data-src");
          if (dataSrc) {
            imageEl.src = dataSrc;
            imageEl.removeAttribute("data-src");
          }
        });
      });
    </script>
  </body>
</html>