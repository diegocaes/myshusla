---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { googleBusinessProfile } from '../data/reviews';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "MyShus - Limpieza de Zapatillas Panamá | Servicio a Domicilio",
  description = "Limpieza profesional de zapatillas en Panamá. Servicio de lavado y restauración de zapatos a domicilio. Recogida y entrega gratis en Panamá Ciudad.",
  keywords = "limpieza de zapatillas Panamá, limpieza de zapatos a domicilio Panamá, servicio de limpieza de zapatillas Panamá, lavado de zapatillas Panamá, restauración de zapatos Panamá, limpieza profesional calzado Panamá Ciudad"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://myshusla.com").href;

// src/layouts/Layout.astro
const GA_TRACKING_ID = "G-JESF85NFZ1"; // Tu ID de Google Analytics

// Datos estructurados (Schema.org) para Google y asistentes de IA.
// El rating y el número de reseñas se toman automáticamente de src/data/reviews.ts
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://myshusla.com/#business",
  "name": "MyShus",
  "alternateName": "MyShus - Limpieza de Zapatillas Panamá",
  "description": "Servicio profesional de limpieza, lavado y restauración de zapatillas y sneakers en Ciudad de Panamá. Especialistas en calzado deportivo y de lujo, con recogida y entrega gratis a domicilio. Limpieza Sencilla desde $18 y Limpieza Completa desde $25 por par, con descuentos por volumen.",
  "url": "https://myshusla.com",
  "image": "https://myshusla.com/images/main-header.png",
  "logo": "https://myshusla.com/images/myshus-logo-dark.png",
  "telephone": "+507-6443-9110",
  "priceRange": "$$",
  "currenciesAccepted": "USD",
  "knowsLanguage": "es",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ciudad de Panamá",
    "addressRegion": "Panamá",
    "addressCountry": "PA",
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 8.9824, "longitude": -79.5199 },
  "areaServed": { "@type": "City", "name": "Ciudad de Panamá" },
  "serviceType": [
    "Limpieza de zapatillas", "Limpieza de sneakers", "Lavado de zapatos",
    "Restauración de calzado", "Impermeabilización de zapatillas", "Blanqueamiento de suelas",
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "16:30",
    },
  ],
  "makesOffer": [
    {
      "@type": "Offer",
      "name": "Limpieza Sencilla",
      "description": "Limpieza externa (upper, suela y midsole), eliminación de suciedad superficial y tratamiento básico de manchas. Entrega en 4-5 días hábiles. $15 por par desde 3 pares.",
      "price": "18",
      "priceCurrency": "USD",
      "category": "Sneaker Cleaning",
    },
    {
      "@type": "Offer",
      "name": "Limpieza Completa",
      "description": "Limpieza externa e interna (plantillas y forros), lavado y desinfección de cordones y eliminación de malos olores. Entrega en 5-7 días hábiles. $22 por par desde 3 pares.",
      "price": "25",
      "priceCurrency": "USD",
      "category": "Sneaker Cleaning",
    },
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios extras",
    "itemListElement": [
      { "@type": "Offer", "name": "Impermeabilización", "price": "10", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Blanqueamiento de suelas", "price": "10", "priceCurrency": "USD" },
      { "@type": "Offer", "name": "Servicio Express 24-48 horas", "price": "5", "priceCurrency": "USD" },
    ],
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+507-6443-9110",
    "contactType": "Customer Service",
    "availableLanguage": "Spanish",
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": googleBusinessProfile.averageRating.toFixed(1),
    "reviewCount": String(googleBusinessProfile.totalReviews),
    "bestRating": "5",
    "worstRating": "1",
  },
  "sameAs": ["https://www.instagram.com/myshusla", "https://wa.me/+50764439110"],
};
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="MyShus" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Geo Tags -->
    <meta name="geo.region" content="PA" />
    <meta name="geo.placename" content="Panama City" />
    <meta name="geo.position" content="8.9824;-79.5199" />
    <meta name="ICBM" content="8.9824, -79.5199" />

    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://myshusla.com/images/preview-image.png" />
    <meta property="og:url" content="https://myshusla.com" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://myshusla.com/images/preview-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}></script>
    <script is:inline define:vars={{ GA_TRACKING_ID }}>
      window.dataLayer = window.dataLayer || [];
      // Usamos 'arguments' directamente, es la forma más común y robusta para gtag.
      // Astro procesará este script y lo incluirá tal cual en el HTML final.
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_TRACKING_ID);
    </script>

    <script is:inline>
      document.addEventListener("click", function (event) {
        const link = event.target.closest('a[href*="wa.me"]');
        if (!link) return;
        const source = link.dataset.waSource || link.id || link.getAttribute("aria-label") || link.textContent.trim().slice(0, 40) || "unknown";
        const page = window.location.pathname;
        if (typeof gtag === "function") {
          gtag("event", "whatsapp_click", {
            event_category: "engagement",
            event_label: source,
            page_path: page,
          });
        }
      });
    </script>

    <!-- Structured Data for Local Business -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <slot />
    <WhatsAppButton />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const lazyImages = document.querySelectorAll("img[data-src]");
        lazyImages.forEach((img) => {
          const imageEl = img as HTMLImageElement; // Type assertion para TypeScript
          const dataSrc = imageEl.getAttribute("data-src");
          if (dataSrc) {
            imageEl.src = dataSrc;
            imageEl.removeAttribute("data-src");
          }
        });

        // Reveal sutil al hacer scroll (respeta prefers-reduced-motion)
        const reveals = document.querySelectorAll(".reveal");
        const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (prefersReduced || !("IntersectionObserver" in window)) {
          reveals.forEach((el) => el.classList.add("in"));
        } else {
          const io = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("in");
                  obs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
          );
          reveals.forEach((el) => io.observe(el));
        }
      });
    </script>
  </body>
</html>