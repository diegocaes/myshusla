---
import { Clock, Calendar, ArrowLeft } from 'lucide-astro';
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  readingTime: string;
  keywords?: string;
}

const {
  title,
  description,
  publishDate,
  readingTime,
  keywords = ''
} = Astro.props;

const fullTitle = `${title} | MyShus Tips`;
---

<Layout title={fullTitle} description={description} keywords={keywords}>
  <Navbar />
  <article class="blog-post">
    <div class="blog-container">
      <a href="/tips" class="back-link">
        <ArrowLeft size={20} />
        <span>Volver a Tips</span>
      </a>

      <header class="post-header">
        <h1 class="post-title">{title}</h1>

        <div class="post-meta">
          <div class="meta-item">
            <Calendar size={16} />
            <time datetime={publishDate}>{publishDate}</time>
          </div>
          <div class="meta-item">
            <Clock size={16} />
            <span>{readingTime}</span>
          </div>
        </div>
      </header>

      <div class="post-content">
        <slot />
      </div>

      <footer class="post-footer">
        <div class="cta-box">
          <h3>¿Necesitas limpiar tus zapatillas?</h3>
          <p>Descubre nuestros servicios profesionales de limpieza</p>
          <a href="/#services" class="cta-button">Ver Servicios</a>
        </div>
      </footer>
    </div>
  </article>
  <Contact />
</Layout>

<style>
  .blog-post {
    min-height: 100vh;
    background-color: var(--background-white);
  }

  .blog-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: var(--spacing-lg);
    transition: color var(--transition-fast) var(--transition-easing);
  }

  .back-link:hover {
    color: var(--accent-gold);
  }

  .post-header {
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--border-color);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .post-meta {
    display: flex;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }

  .meta-item :global(svg) {
    color: var(--accent-gold);
  }

  .post-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .post-content :global(h2) {
    font-size: 1.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: var(--spacing-xl) 0 var(--spacing-md) 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: var(--spacing-lg) 0 var(--spacing-md) 0;
    line-height: 1.4;
  }

  .post-content :global(p) {
    margin: 0 0 var(--spacing-md) 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 var(--spacing-md) 0;
    padding-left: var(--spacing-lg);
  }

  .post-content :global(li) {
    margin-bottom: var(--spacing-sm);
  }

  .post-content :global(strong) {
    font-weight: 600;
    color: var(--color-primary);
  }

  .post-content :global(a) {
    color: var(--accent-gold);
    text-decoration: underline;
    transition: opacity var(--transition-fast) var(--transition-easing);
  }

  .post-content :global(a:hover) {
    opacity: 0.8;
  }

  .post-content :global(blockquote) {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md) var(--spacing-lg);
    border-left: 4px solid var(--accent-gold);
    background-color: var(--background-color);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .post-footer {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--border-color);
  }

  .cta-box {
    background: var(--background-color);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    text-align: center;
  }

  .cta-box h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-sm) 0;
  }

  .cta-box p {
    font-size: 1rem;
    color: var(--color-text-light);
    margin: 0 0 var(--spacing-lg) 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.5rem;
    background: var(--gradient-green);
    color: #FFFFFF;
    font-family: var(--primary-font);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all var(--transition-fast) var(--transition-easing);
    box-shadow: var(--glow-green);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .cta-button:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.6);
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
    }

    .cta-box {
      padding: var(--spacing-lg);
    }

    .cta-box h3 {
      font-size: 1.25rem;
    }

    .cta-button {
      width: 100%;
      max-width: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .cta-button {
      transition: none;
    }

    .cta-button:hover {
      transform: none;
    }
  }
</style>
