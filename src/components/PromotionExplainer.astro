---
const rows = [
  { pairs: '1 par', sencilla: '$18', completa: '$25', save: '—', disc: false },
  { pairs: '2 pares', sencilla: '$36', completa: '$50', save: '—', disc: false },
  { pairs: '3 pares', sencilla: '$45', completa: '$66', save: '$18', disc: true },
  { pairs: '4 pares', sencilla: '$60', completa: '$88', save: '$24', disc: true },
  { pairs: '5 pares', sencilla: '$75', completa: '$110', save: '$30', disc: true },
  { pairs: '6 pares', sencilla: '$90', completa: '$132', save: '$36', disc: true },
];

const notes = [
  'Descuento válido para 3 o más pares en el mismo pedido',
  'Puedes mezclar Limpieza Sencilla y Completa',
  'Recogida y entrega siempre gratis',
];
---

<section id="precios" class="pricing">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Precios por volumen</span>
      <h2 class="display sec-title">Mientras más pares,<br />menos pagas.</h2>
      <p class="sec-lead">
        Junta las zapatillas de la familia o tu colección completa. A partir de 3 pares
        el precio baja por cada par.
      </p>
    </div>

    <div class="table-card reveal">
      <table class="ptable">
        <thead>
          <tr>
            <th>Cantidad</th>
            <th>Sencilla</th>
            <th>Completa</th>
            <th class="th-save">Ahorras</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={r.disc ? 'is-disc' : ''}>
              <td class="td-pairs">{r.pairs}</td>
              <td>{r.sencilla}</td>
              <td>{r.completa}</td>
              <td class="td-save">{r.save}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <ul class="notes reveal">
      {notes.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  .pricing { background: var(--bg); padding: 6rem 0; }

  .sec-head { max-width: 40rem; margin-bottom: 3rem; }
  .sec-head .eyebrow { margin-bottom: 1.1rem; }
  .sec-title { font-size: clamp(2.2rem, 4.6vw, 3.4rem); margin-bottom: 1.1rem; }
  .sec-lead { font-size: 1.12rem; color: var(--ink-soft); line-height: 1.6; margin: 0; }

  .table-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .ptable { width: 100%; border-collapse: collapse; }
  .ptable td, .ptable th { white-space: nowrap; }

  .ptable th {
    text-align: right;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .ptable th:first-child { text-align: left; }

  .ptable td {
    text-align: right;
    padding: 1rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .ptable tbody tr:last-child td { border-bottom: none; }

  .td-pairs { text-align: left !important; font-weight: 500; color: var(--ink-soft); }

  .is-disc { background: var(--accent-soft); }
  .is-disc .td-pairs { color: var(--ink); font-weight: 600; }

  .td-save { color: var(--ink-faint); font-weight: 700; }
  .is-disc .td-save { color: var(--accent-deep); }
  .th-save { color: var(--ink-faint); }

  .notes {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .notes li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 600px) {
    .pricing { padding: 4.5rem 0; }
    .ptable th, .ptable td { padding: 0.8rem 0.65rem; font-size: 0.92rem; }
    .ptable th { font-size: 0.62rem; letter-spacing: 0.02em; }
    .td-pairs { font-size: 0.88rem; }
    .notes { flex-direction: column; gap: 0.6rem; }
  }

  @media (max-width: 360px) {
    .ptable th, .ptable td { padding: 0.7rem 0.5rem; font-size: 0.85rem; }
  }
</style>
