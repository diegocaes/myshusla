---
// Banner component
---

<aside class="banner" role="banner" aria-label="Mensaje de servicio">
  <p><strong>RECOGIDA Y ENTREGA GRATIS*</strong> </p>
</aside>

<style>
  .banner {
    background: var(--neon-yellow);
    color: #000000;
    text-align: center;
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.9375rem;
    font-weight: 700;
    animation: fadeIn 0.6s ease-out;
    box-shadow: 0 2px 8px rgba(255, 235, 59, 0.25);
    border-bottom: 2px solid var(--neon-yellow-hover);
  }

  .banner p {
    margin: 0;
    padding: 0;
    line-height: 1.5;
    font-family: var(--primary-font);
  }

  .banner strong {
    font-weight: 700;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .banner {
      font-size: 0.875rem;
      padding: var(--spacing-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner {
      animation: none;
    }
  }
</style>
