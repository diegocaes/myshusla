---
import { Tag, ShoppingCart } from 'lucide-astro';
import type { Product } from '../data/products';
import { siteConfig } from '../config';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Calcular porcentaje de descuento si existe precio original
const discountPercent = product.originalPrice
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : 0;

// Crear link de WhatsApp con el mensaje del producto
const whatsappMessage = product.whatsappMessage ||
  `Hola! Me interesa comprar ${product.name} que vi en myshusla.com/store`;
const whatsappLink = `https://wa.me/${siteConfig.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(whatsappMessage)}`;
---

<article class="product-card">
  {discountPercent > 0 && (
    <div class="discount-badge">
      <Tag size={16} />
      <span>-{discountPercent}%</span>
    </div>
  )}

  {!product.inStock && (
    <div class="out-of-stock-overlay">
      <span>Agotado</span>
    </div>
  )}

  <a href={`/store/${product.id}`} class="product-image-link">
    <div class="product-image">
      <img
        src={product.images[0]}
        alt={product.name}
        loading="lazy"
      />
    </div>
  </a>

  <div class="product-info">
    <h3 class="product-name">
      <a href={`/store/${product.id}`}>{product.name}</a>
    </h3>

    <p class="product-description">{product.description}</p>

    <div class="product-features">
      {product.features.slice(0, 3).map(feature => (
        <span class="feature-tag">✓ {feature}</span>
      ))}
    </div>

    <div class="product-footer">
      <div class="product-pricing">
        {product.originalPrice && (
          <span class="original-price">${product.originalPrice}</span>
        )}
        <span class="current-price">${product.price}</span>
      </div>

      <a
        href={whatsappLink}
        target="_blank"
        class="buy-button"
        data-product-id={product.id}
      >
        <ShoppingCart size={18} />
        <span>Comprar</span>
      </a>
    </div>

    {!product.inStock && (
      <div class="notify-me">
        <a href={`https://wa.me/${siteConfig.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hola! Quiero que me notifiquen cuando ${product.name} esté disponible`)}`} target="_blank">
          Notificarme cuando llegue
        </a>
      </div>
    )}
  </div>
</article>

<style>
  .product-card {
    background: var(--background-white);
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-color: var(--accent-gold);
  }

  .discount-badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    background: var(--gradient-green);
    color: #FFFFFF;
    padding: 0.375rem 0.75rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.3);
  }

  .out-of-stock-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    backdrop-filter: blur(2px);
  }

  .out-of-stock-overlay span {
    background: var(--color-primary);
    color: var(--color-secondary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--border-radius);
    font-weight: 700;
    font-size: 1.125rem;
  }

  .product-image-link {
    display: block;
    text-decoration: none;
  }

  .product-image {
    width: 100%;
    aspect-ratio: 1;
    background: var(--background-light);
    overflow: hidden;
    position: relative;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-fast) var(--transition-easing);
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .product-info {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    flex: 1;
  }

  .product-name {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .product-name a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast) var(--transition-easing);
  }

  .product-name a:hover {
    color: var(--accent-gold);
  }

  .product-description {
    color: var(--color-text-light);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  .product-features {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .feature-tag {
    font-size: 0.8125rem;
    color: var(--color-text-lighter);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-top: auto;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color-light);
  }

  .product-pricing {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .original-price {
    font-size: 0.875rem;
    color: var(--color-text-lighter);
    text-decoration: line-through;
  }

  .current-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--gradient-olive);
    color: var(--color-secondary);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all var(--transition-fast) var(--transition-easing);
    white-space: nowrap;
  }

  .buy-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-green);
  }

  .buy-button:active {
    transform: translateY(0);
  }

  .notify-me {
    text-align: center;
    padding-top: var(--spacing-sm);
  }

  .notify-me a {
    color: var(--accent-gold);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color var(--transition-fast) var(--transition-easing);
  }

  .notify-me a:hover {
    color: var(--accent-gold-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .product-info {
      padding: var(--spacing-md);
    }

    .product-name {
      font-size: 1.125rem;
    }

    .product-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .buy-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-name a,
    .product-image img,
    .buy-button {
      transition: none;
    }

    .product-card:hover,
    .buy-button:hover {
      transform: none;
    }
  }
</style>
