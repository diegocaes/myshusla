---
import { MessageCircle } from 'lucide-astro';
import { siteConfig } from '../config';

const imageSrc = "/images/main-header.png";
const whatsappLink = siteConfig.whatsappLinks.header;
---

<header id="home" class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">Limpieza de<br />Todo Tipo de Zapatillas</h1>
      <p class="hero-subtitle">
        Servicio profesional de limpieza y renovación de zapatillas en Panamá
      </p>
      <a href={whatsappLink} target="_blank" class="cta-button" data-track="cta-header">
        <MessageCircle size={20} />
        <span>¡Agenda Ahora!</span>
      </a>
    </div>
  </div>

  <div class="hero-image">
    <img src={imageSrc} alt="Servicio de limpieza de zapatillas en Panamá" width="800" height="533" loading="eager" />
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 45vh;
    background-color: var(--background-color);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 0.95) 40%,
      rgba(255, 255, 255, 0) 70%
    );
    z-index: 1;
  }

  .hero-image {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 55%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    z-index: 0;
    padding-right: var(--spacing-lg);
  }

  .hero-image img {
    width: auto;
    height: 90%;
    max-width: 600px;
    object-fit: contain;
    object-position: right center;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    width: 100%;
    padding: var(--spacing-xl) var(--spacing-lg);
    margin: 0 auto;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-title {
    font-family: var(--primary-font);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-md) 0;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-family: var(--primary-font);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-light);
    margin: 0 0 var(--spacing-lg) 0;
    max-width: 500px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: 1.125rem 2.5rem;
    background: var(--accent-gold);
    color: #FFFFFF;
    font-family: var(--primary-font);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--border-radius);
    border: none;
    box-shadow: var(--glow-green);
    transition: all var(--transition-fast) var(--transition-easing);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .cta-button:hover {
    transform: translateY(-3px) scale(1.02);
    background: var(--accent-gold-hover);
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.6);
  }

  .cta-button:active {
    transform: translateY(0);
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero {
      min-height: 50vh;
    }

    .hero-image {
      width: 100%;
      opacity: 0.15;
    }

    .hero-container {
      padding: var(--spacing-lg) var(--spacing-md);
      text-align: center;
    }

    .hero-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      text-align: center;
    }

    .hero-subtitle {
      text-align: center;
      max-width: 100%;
    }

    .cta-button {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 45vh;
    }

    .cta-button {
      padding: 0.875rem 1.5rem;
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }

    .cta-button:hover {
      transform: none;
    }
  }
</style>
