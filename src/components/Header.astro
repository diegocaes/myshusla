---
import { siteConfig } from '../config';

const whatsappLink = siteConfig.whatsappLinks.header;
const cleaned = siteConfig.stats.sneakersCleaned;
---

<header id="home" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow reveal"><span class="dot"></span>Servicio profesional de limpieza · Panamá</span>

      <h1 class="display hero-title reveal">
        Limpiamos<br />tus zapatillas.<br />
      </h1>

      <p class="hero-sub reveal">
        Limpieza profesional de zapatillas en Ciudad de Panamá.
        Las recogemos, las dejamos impecables y te las devolvemos.
        <strong>Recogida y entrega gratis.</strong>
      </p>

      <div class="hero-cta reveal">
        <a href={whatsappLink} class="btn" target="_blank" rel="noopener" data-wa-source="hero">
          <span class="wa-dot"></span> Agenda por WhatsApp
        </a>
        <a href="#servicios" class="btn-ghost">Ver servicios</a>
      </div>

      <p class="hero-proof reveal">
        +{cleaned} pares limpiados &nbsp;·&nbsp; 5.0 ★ en Google &nbsp;·&nbsp; Express 24–48 h
      </p>
    </div>

    <div class="hero-visual reveal">
      <div class="hero-frame">
        <img
          src="/images/main-header.png"
          alt="Limpieza profesional de zapatillas en Panamá — antes y después"
          width="600"
          height="600"
          loading="eager"
        />
      </div>
      <div class="hero-badge">
        <span class="badge-num">100%</span>
        <span class="badge-txt">garantía de<br />satisfacción</span>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    background: var(--bg);
    padding-top: 3rem;
    padding-bottom: 3.5rem;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4rem;
    align-items: center;
    min-height: calc(86vh - var(--navbar-height));
  }

  .hero-copy .eyebrow { margin-bottom: 1.6rem; }

  .hero-title {
    font-size: clamp(2.9rem, 6.4vw, 5.4rem);
    margin-bottom: 1.6rem;
  }

  .hero-sub {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 0 0 2.2rem;
  }

  .hero-sub strong { color: var(--ink); font-weight: 600; }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero-proof {
    font-size: 0.9rem;
    color: var(--ink-faint);
    font-weight: 500;
    margin: 0;
  }

  /* Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    border-radius: var(--border-radius-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-badge {
    position: absolute;
    bottom: -14px;
    left: -14px;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--border-radius);
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    box-shadow: var(--shadow-lg);
  }

  .badge-num {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .badge-txt {
    font-size: 0.72rem;
    line-height: 1.25;
    color: rgba(244, 241, 233, 0.85);
    font-weight: 500;
  }

  /* Stagger the reveal */
  .hero-copy .reveal:nth-child(1) { transition-delay: 0.02s; }
  .hero-copy .reveal:nth-child(2) { transition-delay: 0.08s; }
  .hero-copy .reveal:nth-child(3) { transition-delay: 0.14s; }
  .hero-copy .reveal:nth-child(4) { transition-delay: 0.2s; }
  .hero-copy .reveal:nth-child(5) { transition-delay: 0.26s; }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      min-height: 0;
      text-align: center;
    }

    .hero-copy .eyebrow { justify-content: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-cta { justify-content: center; }
    .hero-visual { order: -1; }
    .hero-frame { max-width: 340px; }
  }

  @media (max-width: 480px) {
    .hero { padding-top: 2rem; }
    .hero-title { font-size: clamp(2.6rem, 11vw, 3.4rem); }
    .hero-cta .btn, .hero-cta .btn-ghost { width: 100%; }
    .hero-frame { max-width: 280px; }
  }
</style>
