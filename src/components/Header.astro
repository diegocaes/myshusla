---
const imageSrc = "/images/main-header.png"; 
const whatsappLink = "https://wa.me/+50764439110?text=Hola%21%20Llegué%20desde%20la%20web%20myshusla.com%20y%20quiero%20información%20sobre%20el%20servicio%20de%20limpieza%20de%20zapatillas"; // 
 
---

<header id="home" class="hero">
  <div class="hero-content">
    <h1 class="hero-title">Limpieza de Zapatillas en Panamá</h1>
    <p class="small-text">
      Servicio profesional de lavado y restauración de zapatillas a domicilio. ¡Recogida y entrega gratis!
    </p>
    <div class="cta-buttons">
      <a href={whatsappLink} target="_blank" class="btn btn-primary" data-track="cta-header">
        <img src="/images/whatsapp-icon.png" alt="WhatsApp" class="btn-icon" width="20" height="20" loading="eager" />
        ¡Agenda Tu Limpieza Ahora!
      </a>
    </div>
  </div>

  <!-- Image Section -->
  <div class="hero-image">
    <img src={imageSrc} alt="Sneaker Cleaning Experts" class="hero-logo" width="600" height="400" loading="eager" />
  </div>
</header>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--background-color);
    padding: 0 7rem;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
  }

  .hero-content {
    flex: 1;
    max-width: 50%;
    padding-bottom: var(--spacing-md);
  }

  .small-text {
    font-family: var(--font-primary);
    font-size: 1.1rem;
    font-weight: 500;
    color: #6b705c;
    margin-bottom: var(--spacing-md);
  }

  .hero-title {
    font-family: var(--font-primary);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: flex-start;
    margin-top: var(--spacing-md);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    font-family: var(--font-primary);
    font-size: 1rem;
    padding: 0.75rem var(--spacing-md);
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    font-weight: 600;
    transition: all var(--transition-duration) ease;
  }

  .btn-primary {
    background-color: var(--primary-green);
    color: var(--color-secondary);
    border: none;
  }

  .btn-secondary {
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    background-color: transparent;
  }

  .btn-primary:hover,
  .btn-secondary:hover {
    transform: scale(1.05);
  }

  .btn-icon {
    height: 20px;
    width: 20px;
    object-fit: contain;
  }

  /* Hero Image Section */
  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    max-height: 700px; /* Increased for a larger image */
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
      padding: var(--spacing-xl) var(--spacing-md);
      height: auto;
    }

    .hero-content {
      max-width: 100%;
      margin-bottom: var(--spacing-lg);
    }

    .hero-title {
      font-size: 2rem;
      line-height: 1.2;
    }

    .small-text {
      font-size: 1rem;
    }

    .cta-buttons {
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      width: 100%;
      max-width: 300px;
    }

    .hero-image {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn:hover {
      transform: none;
    }
  }
</style>
