---
import { ShoppingBag, ArrowRight } from 'lucide-astro';
import ProductCard from './ProductCard.astro';
import { getVisibleProducts } from '../data/products';

const featuredProducts = getVisibleProducts().slice(0, 3);
---

<section id="store-preview" class="store-preview-section" aria-labelledby="store-preview-heading">
  <div class="store-preview-container">
    <header class="store-preview-header">
      <div class="header-badge">
        <ShoppingBag size={16} />
        <span>Tienda MyShus</span>
      </div>
      <h2 id="store-preview-heading" class="section-title">Productos para cuidar tus zapatillas</h2>
      <p class="section-subtitle">
        Hormas, sílica gel y kits de limpieza profesionales. Envío gratis en pedidos sobre $25.
      </p>
    </header>

    <div class="products-grid">
      {featuredProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <div class="store-cta">
      <a href="/store/" class="store-cta-button">
        Ver toda la tienda
        <ArrowRight size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .store-preview-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    background-color: var(--background-color);
  }

  .store-preview-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .store-preview-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: rgba(37, 211, 102, 0.1);
    color: var(--accent-gold);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 var(--spacing-sm) 0;
    color: var(--color-primary);
    font-weight: 600;
    font-family: var(--primary-font);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    margin: 0 auto;
    max-width: 640px;
    font-weight: 400;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .store-cta {
    text-align: center;
  }

  .store-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-primary);
    color: var(--background-white);
    border-radius: var(--border-radius-lg);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--transition-speed) var(--transition-easing);
  }

  .store-cta-button:hover {
    background-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--glow-green);
  }

  @media (max-width: 768px) {
    .store-preview-section {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-cta-button {
      transition: none;
    }

    .store-cta-button:hover {
      transform: none;
    }
  }
</style>
