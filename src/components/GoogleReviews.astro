---
import { Star } from 'lucide-astro';
import { googleReviews, googleBusinessProfile } from '../data/reviews';
---

<section id="resenas" class="reviews">
  <div class="wrap">
    <div class="reviews-head reveal">
      <div>
        <span class="eyebrow"><span class="dot"></span>Reseñas de Google</span>
        <h2 class="display sec-title">Clientes que<br />volverían a hacerlo.</h2>
      </div>
      <div class="rating-card">
        <div class="rating-num">{googleBusinessProfile.averageRating.toFixed(1)}</div>
        <div class="rating-stars" aria-label={`${googleBusinessProfile.averageRating} de 5 estrellas`}>
          {Array.from({ length: 5 }).map(() => <Star size={18} class="st" />)}
        </div>
        <div class="rating-meta">{googleBusinessProfile.totalReviews} reseñas en Google</div>
      </div>
    </div>

    <div class="rgrid">
      {googleReviews.map((r) => (
        <figure class="rcard reveal">
          <div class="rcard-stars" aria-label={`${r.rating} de 5 estrellas`}>
            {Array.from({ length: r.rating }).map(() => <Star size={15} class="st" />)}
          </div>
          <blockquote class="rcard-text">{r.comment}</blockquote>
          <figcaption class="rcard-by">
            <span class="avatar">{r.avatarInitial}</span>
            <span class="by-meta">
              <span class="by-name">{r.author}</span>
              <span class="by-date">{r.date}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="reviews-link reveal">
      <a href={googleBusinessProfile.url} target="_blank" rel="noopener" class="btn-ghost">
        Ver reseñas en Google
      </a>
    </div>
  </div>
</section>

<style>
  .reviews { background: var(--bg-2); padding: 6rem 0; }

  .reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .reviews-head .eyebrow { margin-bottom: 1.1rem; }
  .sec-title { font-size: clamp(2.2rem, 4.6vw, 3.4rem); margin: 0; }

  .rating-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--border-radius);
    padding: 1.25rem 1.5rem;
  }

  .rating-num {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }

  .rating-stars { display: flex; gap: 2px; }
  .reviews :global(.st) { color: var(--accent); fill: var(--accent); }
  .rating-meta { font-size: 0.85rem; color: var(--ink-faint); }

  .rgrid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .rcard {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--border-radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .rcard-stars { display: flex; gap: 2px; margin-bottom: 1rem; }

  .rcard-text {
    margin: 0 0 1.4rem;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--ink-soft);
    flex: 1;
  }

  .rcard-by { display: flex; align-items: center; gap: 0.7rem; }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .by-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .by-name { font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  .by-date { font-size: 0.78rem; color: var(--ink-faint); }

  .reviews-link { margin-top: 2.25rem; }

  @media (max-width: 1000px) {
    .rgrid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .reviews { padding: 4.5rem 0; }
    .rgrid { grid-template-columns: 1fr; }
  }
</style>
