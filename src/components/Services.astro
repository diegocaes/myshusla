---
import { Sparkles, Star, Zap } from 'lucide-astro';

const services = [
  {
    title: "Limpieza Sencilla",
    price: "$18",
    duration: "4-5 días hábiles",
    description: [
      "Limpieza externa (upper, suela, y midsole)",
      "Eliminación de suciedad superficial",
      "Tratamiento básico de manchas",
      "3+ pares = $15 c/u"
    ],
    image: "/images/sneaker-cleaning.png",
    icon: Sparkles,
    popular: false
  },
  {
    title: "Limpieza Completa",
    price: "$25",
    duration: "5-7 días hábiles",
    description: [
      "Todo lo de Limpieza Sencilla +",
      "Limpieza interna (plantillas y forros)",
      "Lavado y desinfección de cordones",
      "Eliminación de malos olores",
      "3+ pares = $22 c/u"
    ],
    image: "/images/luxury-sneaker-care.png",
    icon: Star,
    popular: true
  },
  {
    title: "Servicios Extras",
    price: "Desde $10",
    duration: "+1 día adicional",
    description: [
      "Impermeabilización: $10",
      "Blanqueamiento de suelas: $10",
      "Restauración de materiales: cotizar",
      "Servicio Express (24-48 horas): +$5"
    ],
    image: "/images/sports-shoes-cleaning.png",
    icon: Zap,
    popular: false
  },
];
---

<section id="services" class="services-section">
  <div class="services-container">
    <h2 class="section-title">Nuestros Servicios</h2>
    <p class="section-subtitle">Cuidado profesional adaptado a las necesidades de tu calzado</p>

    <div class="services-grid">
      {services.map((service) => {
        const Icon = service.icon;
        return (
          <div class={`service-card ${service.popular ? 'popular' : ''}`}>
            {service.popular && (
              <div class="popular-badge">
                <Star size={14} />
                <span>Más Popular</span>
              </div>
            )}

            <div class="service-header">
              <div class="service-icon-wrapper">
                <Icon size={28} class="service-icon" />
              </div>
              <img
                src={service.image}
                alt={service.title}
                class="service-image"
                width="400"
                height="200"
                loading="lazy"
              />
            </div>

            <div class="service-content">
              <h3 class="service-title">{service.title}</h3>

              <div class="service-pricing">
                <span class="service-price">{service.price}</span>
                <span class="service-duration">{service.duration}</span>
              </div>

              <ul class="service-description">
                {service.description.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg) var(--spacing-lg);
    background-color: var(--background-white);
  }

  .services-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
    font-weight: 600;
    font-family: var(--primary-font);
    text-align: center;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    text-align: center;
    margin-bottom: var(--spacing-xl);
    font-weight: 400;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-lg);
  }

  .service-card {
    background-color: var(--background-white);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--border-color);
    overflow: hidden;
    text-align: left;
    transition: all var(--transition-speed) var(--transition-easing);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--accent-gold);
  }

  .service-card.popular {
    border: 2px solid var(--accent-gold);
    box-shadow: var(--glow-green);
  }

  .popular-badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    background: var(--gradient-green);
    color: #FFFFFF;
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-lg);
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: var(--glow-green);
  }

  .service-header {
    position: relative;
    height: 200px;
    overflow: hidden;
    background: var(--background-color);
  }

  .service-icon-wrapper {
    position: absolute;
    top: var(--spacing-md);
    left: var(--spacing-md);
    background: var(--background-white);
    padding: var(--spacing-sm);
    border-radius: var(--border-radius);
    z-index: 2;
    box-shadow: var(--shadow-sm);
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-speed) var(--transition-easing);
    opacity: 0.9;
  }

  .service-card:hover .service-image {
    transform: scale(1.05);
    opacity: 1;
  }

  .service-content {
    padding: var(--spacing-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
    font-family: var(--primary-font);
    letter-spacing: -0.01em;
  }

  .service-pricing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-color-light);
  }

  .service-price {
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--accent-gold);
    font-family: var(--primary-font);
    letter-spacing: -0.02em;
  }

  .service-duration {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-light);
    background: var(--background-color);
    padding: 0.375rem 0.75rem;
    border-radius: var(--border-radius);
    letter-spacing: 0.01em;
  }

  .service-description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-light);
    font-family: var(--primary-font);
    padding-left: 1.25rem;
    list-style: none;
    margin: 0;
  }

  .service-description li {
    margin-bottom: var(--spacing-sm);
    position: relative;
  }

  .service-description li::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0.6em;
    width: 4px;
    height: 4px;
    background-color: var(--accent-gold);
    border-radius: 50%;
  }

  .service-description li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 968px) {
    .services-section {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .service-card.popular {
      border-width: 1px;
    }
  }

  @media (max-width: 480px) {
    .section-title {
      margin-bottom: var(--spacing-xs);
    }

    .section-subtitle {
      font-size: 1rem;
      margin-bottom: var(--spacing-lg);
    }

    .service-header {
      height: 160px;
    }

    .service-content {
      padding: var(--spacing-md);
    }

    .service-title {
      font-size: 1.25rem;
    }

    .service-price {
      font-size: 1.5rem;
    }

    .service-description {
      font-size: 0.875rem;
    }

    .popular-badge {
      font-size: 0.6875rem;
      padding: 0.375rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-image {
      transition: none;
    }

    .service-card:hover {
      transform: none;
    }

    .service-card:hover .service-image {
      transform: none;
    }
  }
</style>
