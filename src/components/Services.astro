---
import { Check } from 'lucide-astro';
import { siteConfig } from '../config';

const whatsappLink = siteConfig.whatsappLinks.main;

const tiers = [
  {
    name: 'Limpieza Sencilla',
    price: '$18',
    unit: 'por par',
    bulk: '3+ pares · $15 c/u',
    time: '4–5 días hábiles',
    featured: false,
    features: [
      'Limpieza externa: upper, suela y midsole',
      'Eliminación de suciedad superficial',
      'Tratamiento básico de manchas',
      'Cordones limpios y suela limpios',
    ],
  },
  {
    name: 'Limpieza Completa',
    price: '$25',
    unit: 'por par',
    bulk: '3+ pares · $22 c/u',
    time: '5–7 días hábiles',
    featured: true,
    features: [
      'Todo lo de Limpieza Sencilla',
      'Limpieza interna: plantillas y forros',
      'Lavado y desinfección de cordones',
      'Eliminación de malos olores',
    ],
  },
];

const extras = [
  { name: 'Impermeabilización', price: '$10' },
  { name: 'Blanqueamiento de suelas', price: '$10' },
  { name: 'Restauración de materiales', price: 'Cotizar' },
  { name: 'Express 24–48 h', price: '+$5' },
];
---

<section id="servicios" class="services">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="dot"></span>Servicios</span>
      <h2 class="display sec-title">Cuidado profesional<br />para cada par.</h2>
      <p class="sec-lead">
        Dos niveles de limpieza según lo que necesiten tus zapatillas. Todo incluye
        recogida y entrega gratis en Ciudad de Panamá.
      </p>
    </div>

    <div class="tiers">
      {tiers.map((t) => (
        <article class={`tier reveal ${t.featured ? 'is-featured' : ''}`}>
          {t.featured && <span class="tier-flag">Más popular</span>}
          <div class="tier-top">
            <h3 class="tier-name">{t.name}</h3>
            <div class="tier-price">
              <span class="price">{t.price}</span>
              <span class="price-unit">{t.unit}</span>
            </div>
            <p class="tier-meta">{t.bulk} &nbsp;·&nbsp; {t.time}</p>
          </div>
          <ul class="tier-list">
            {t.features.map((f) => (
              <li><Check size={18} class="ck" /> <span>{f}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="extras reveal">
      <div class="extras-head">
        <h3 class="extras-title">Servicios extras</h3>
        <p class="extras-note">Súmalos a cualquier limpieza · +1 día adicional</p>
      </div>
      <ul class="extras-grid">
        {extras.map((e) => (
          <li><span class="ex-name">{e.name}</span><span class="ex-price">{e.price}</span></li>
        ))}
      </ul>
    </div>

    <div class="services-cta reveal">
      <a href={whatsappLink} class="btn" target="_blank" rel="noopener" data-wa-source="services">
        <span class="wa-dot"></span> Pide tu cotización
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg);
    padding: 6rem 0;
  }

  .sec-head { max-width: 40rem; margin-bottom: 3.5rem; }
  .sec-head .eyebrow { margin-bottom: 1.1rem; }

  .sec-title {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    margin-bottom: 1.1rem;
  }

  .sec-lead {
    font-size: 1.12rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  .tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .tier {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--border-radius-lg);
    padding: 2.2rem;
    transition: transform var(--transition-fast) var(--transition-easing),
      box-shadow var(--transition-fast) ease, border-color var(--transition-fast) ease;
  }

  .tier:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .tier.is-featured {
    background: var(--ink);
    border-color: var(--ink);
  }

  .tier.is-featured .tier-name,
  .tier.is-featured .price { color: var(--bg); }
  .tier.is-featured .price-unit,
  .tier.is-featured .tier-meta { color: rgba(244, 241, 233, 0.7); }
  .tier.is-featured .tier-list li { color: rgba(244, 241, 233, 0.92); }
  .tier.is-featured .tier-top { border-bottom-color: rgba(244, 241, 233, 0.16); }

  .tier-flag {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    background: var(--accent);
    color: #06340f;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
  }

  .tier-top {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }

  .tier-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.9rem;
    color: var(--ink);
  }

  .tier-price { display: flex; align-items: baseline; gap: 0.5rem; }

  .price {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }

  .price-unit { font-size: 0.95rem; color: var(--ink-soft); font-weight: 500; }

  .tier-meta {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .tier-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }

  .tier-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .tier-list :global(.ck) {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--accent);
  }

  /* Extras */
  .extras {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--border-radius-lg);
    padding: 2rem 2.2rem;
    display: grid;
    grid-template-columns: 0.9fr 1.6fr;
    gap: 1.5rem 2.5rem;
    align-items: center;
  }

  .extras-title { font-size: 1.2rem; font-weight: 700; margin: 0 0 0.4rem; }
  .extras-note { font-size: 0.9rem; color: var(--ink-faint); margin: 0; }

  .extras-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2.5rem;
  }

  .extras-grid li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.98rem;
  }

  .ex-name { color: var(--ink-soft); }
  .ex-price { font-weight: 700; color: var(--ink); white-space: nowrap; }

  .services-cta { margin-top: 2.5rem; }

  @media (max-width: 820px) {
    .services { padding: 4.5rem 0; }
    .tiers { grid-template-columns: 1fr; }
    .tier { padding: 1.75rem; }
    .extras { grid-template-columns: 1fr; gap: 1.25rem; padding: 1.75rem; }
    .extras-grid { grid-template-columns: 1fr; gap: 0 1rem; }
  }

  @media (max-width: 480px) {
    .services-cta .btn { width: 100%; }
  }
</style>
