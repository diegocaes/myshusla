---
import { siteConfig } from '../config';
---

<div class="ticker-container">
  <div class="ticker-wrapper">
    <div class="ticker-track">
      <span class="ticker-item">Servicio en 24-48 Horas</span>
      <span class="ticker-item">Recogida y Entrega GRATIS</span>
      <span class="ticker-item">Especialistas en Todo Tipo de Zapatillas</span>
      <span class="ticker-item">Garantía 100% de Satisfacción</span>
      <span class="ticker-item">+{siteConfig.stats.sneakersCleaned} Zapatillas Limpiadas</span>
    </div>
    <!-- Duplicado para el efecto infinito seamless -->
    <div class="ticker-track" aria-hidden="true">
      <span class="ticker-item">Servicio en 24-48 Horas</span>
      <span class="ticker-item">Recogida y Entrega GRATIS</span>
      <span class="ticker-item">Especialistas en Todo Tipo de Zapatillas</span>
      <span class="ticker-item">Garantía 100% de Satisfacción</span>
      <span class="ticker-item">+{siteConfig.stats.sneakersCleaned} Zapatillas Limpiadas</span>
    </div>
  </div>
</div>

<style>
  /* Ticker Container */
  .ticker-container {
    overflow: hidden;
    background-color: #fff;
    border: 1px solid #ddd;
    height: 50px;
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
  }

  /* Ticker Wrapper */
  .ticker-wrapper {
    display: flex;
    width: fit-content;
    animation: scroll-left 20s linear infinite;
  }

  /* Ticker Track */
  .ticker-track {
    display: flex;
    flex-shrink: 0;
  }

  /* Ticker Items */
  .ticker-item {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 0 2rem;
    white-space: nowrap; /* Prevent text wrapping */
    color: #333; /* Default dark gray text */
  }

  /* Alternate colors for items */
  .ticker-item:nth-child(odd) {
    color: #000; /* Black */
  }

  .ticker-item:nth-child(even) {
    color: #555; /* Dark gray */
  }

  /* Scrolling Animation */
  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .ticker-wrapper {
      animation-duration: 30s;
    }

    .ticker-item {
      font-size: 0.9rem;
      padding: 0 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-wrapper {
      animation: none;
    }
  }
</style>