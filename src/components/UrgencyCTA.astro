---
import { siteConfig } from '../config';

const whatsappLink = siteConfig.whatsappLinks.urgency;
---

<section class="cta-section">
  <div class="cta-container">
    <p class="cta-label">Oferta de bienvenida</p>
    <h2 class="cta-title">
      20% de descuento<br />en tu primer servicio.
    </h2>
    <p class="cta-sub">
      Válido para nuevos clientes en Ciudad de Panamá.<br />
      Recogida y entrega gratis incluida.
    </p>
    <a href={whatsappLink} target="_blank" class="cta-btn" data-wa-source="urgency">
      Solicitar oferta por WhatsApp
    </a>
    <p class="cta-fine">Garantía de satisfacción 100%. Pagas al recibir.</p>
  </div>
</section>

<style>
  .cta-section {
    padding: 8rem 2rem;
    background: #000000;
  }

  .cta-container {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 1.25rem 0;
  }

  .cta-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem 0;
  }

  .cta-sub {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.65;
    margin: 0 0 2.5rem 0;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    padding: 1.125rem 2.25rem;
    background: #25D366;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 10px;
    letter-spacing: 0.01em;
    transition: opacity 0.2s ease, transform 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .cta-btn:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .cta-fine {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.3);
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 5rem 1.5rem;
    }

    .cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn {
      transition: none;
    }
    .cta-btn:hover {
      transform: none;
    }
  }
</style>
