---
import { siteConfig } from '../config';

const stats = [
  { value: `+${siteConfig.stats.sneakersCleaned}`, label: "pares limpiados" },
  { value: "5.0 ⭐", label: "promedio en Google" },
  { value: "100%", label: "garantía de satisfacción" },
  { value: "Gratis", label: "recogida y entrega" },
];
---

<section class="stats-section">
  <div class="stats-container">
    {stats.map((stat, i) => (
      <div class="stat-item">
        <div class="stat-value">{stat.value}</div>
        <div class="stat-label">{stat.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-section {
    padding: 5rem 2rem;
    background: #0A0A0A;
  }

  .stats-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .stat-item {
    text-align: center;
    padding: 1rem 0;
  }

  .stat-value {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.625rem;
  }

  .stat-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .stats-section {
      padding: 3.5rem 1.5rem;
    }

    .stats-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 400px) {
    .stats-container {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
