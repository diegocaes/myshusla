---
const trustFeatures = [
  {
    icon: "🚚",
    title: "Recogida y Entrega GRATIS",
    description: "Servicio a domicilio sin costo adicional en zonas seleccionadas de Panamá"
  },
  {
    icon: "⚡",
    title: "Servicio Rápido",
    description: "Entrega en 6 días hábles o menos. Tu calzado listo cuando lo necesites"
  },
  {
    icon: "🛡️",
    title: "100% Garantizado",
    description: "Si no quedas satisfecho, repetimos el servicio sin costo"
  },
  {
    icon: "🧽",
    title: "Productos Profesionales",
    description: "Usamos productos especializados seguros para todo tipo de materiales"
  }
];
---

<section class="trust-section">
  <div class="container">
    <h2 class="section-title">¿Por Qué Elegir MyShus?</h2>
    <div class="trust-grid">
      {trustFeatures.map((feature) => (
        <div class="trust-card">
          <div class="trust-icon">{feature.icon}</div>
          <h3 class="trust-title">{feature.title}</h3>
          <p class="trust-description">{feature.description}</p>
        </div>
      ))}
    </div>
    
    <div class="guarantee-banner">
      <div class="guarantee-content">
        <h3>🏆 Garantía de Satisfacción 100%</h3>
        <p>Más de 70 pares de zapatillas limpiadas con clientes satisfechos en Panamá</p>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    background-color: white;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--color-primary);
    font-weight: 700;
    font-family: var(--primary-font);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .trust-card {
    text-align: center;
    padding: 2rem 1rem;
    background: #f8f9fa;
    border-radius: 15px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .trust-card:hover {
    border-color: var(--primary-green);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.1);
  }

  .trust-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
  }

  .trust-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-family: var(--primary-font);
  }

  .trust-description {
    color: #666;
    line-height: 1.6;
    font-size: 1rem;
  }

  .guarantee-banner {
    background: linear-gradient(135deg, var(--primary-green) 0%, var(--primary-green-hover) 100%);
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.3);
  }

  .guarantee-content h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .guarantee-content p {
    color: white;
    font-size: 1.1rem;
    opacity: 0.95;
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .trust-section {
      padding: 2rem 1rem;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 2rem;
    }

    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .trust-card {
      padding: 1.5rem 1rem;
    }

    .trust-icon {
      font-size: 2.5rem;
    }

    .guarantee-banner {
      padding: 1.5rem;
    }

    .guarantee-content h3 {
      font-size: 1.3rem;
    }

    .guarantee-content p {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-card {
      transition: none;
    }
    
    .trust-card:hover {
      transform: none;
    }
  }
</style>