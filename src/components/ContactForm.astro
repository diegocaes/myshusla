---
const whatsappLink = "https://wa.me/+50764439110";
const formAction = "https://formspree.io/f/myzylozq";
---

<section id="contact-form" class="contact-form-section">
  <div class="contact-form-container">
    <h2 class="form-title">Déjanos tu Sugerencia</h2>
    <p class="form-description">
      Nos encantaría saber tu opinión o sugerencia para mejorar nuestros
      servicios.
    </p>

    <!-- Formulario -->
    <form
      action={formAction}
      method="POST"
      class="form"
      id="sugerencia-form"
      onsubmit="return showThankYouMessage(event)"
    >
      <label for="name">Nombre</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Tu Nombre"
        required
      />

      <label for="email">Correo Electrónico</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="Tu Correo Electrónico"
        required
      />

      <label for="message">Mensaje</label>
      <textarea
        id="message"
        name="message"
        placeholder="Escribe tu sugerencia aquí..."
        required></textarea>

      <button type="submit">Enviar Sugerencia</button>
    </form>

    <!-- Mensaje de Agradecimiento (Oculto) -->
    <div
      class="thank-you-message"
      id="thank-you-message"
      style="display: none;"
    >
      <p>
        ¡Gracias por escribirnos! 😊 Te responderemos de una cuando veamos tu
        mensaje.
      </p>
    </div>

    <!-- WhatsApp Section -->
    <div class="whatsapp-section">
      <p class="whatsapp-text">
        ¿Prefieres escribirnos directamente por WhatsApp? ¡Haz clic abajo!
      </p>
      <a href={whatsappLink} target="_blank" class="whatsapp-button">
        Escríbenos por WhatsApp
      </a>
    </div>
  </div>
</section>


<style>
  .contact-form-section {
    padding: var(--spacing-xl) var(--spacing-lg);
    background-color: var(--background-color);
    color: var(--color-text);
    text-align: center;
  }

  .contact-form-container {
    font-family: var(--font-primary);
    max-width: 600px;
    margin: 0 auto;
    background-color: var(--color-secondary);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-sm);
    box-shadow: var(--shadow-md);
  }

  .form-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }

  .form-description {
    font-size: 1rem;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-light);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form input,
  .form textarea {
    font-size: 1rem;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: var(--border-radius-sm);
    width: 100%;
    box-sizing: border-box;
    outline: none;
  }

  .form input:focus,
  .form textarea:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 5px rgba(37, 211, 102, 0.5);
  }

  .form button {
    background-color: var(--primary-green);
    color: var(--color-secondary);
    padding: 0.75rem var(--spacing-md);
    border: none;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: background-color var(--transition-duration) ease;
  }

  .form button:hover {
    background-color: var(--primary-green-hover);
  }

  /* WhatsApp Section */
  .whatsapp-section {
    margin-top: var(--spacing-lg);
    text-align: center;
  }

  .whatsapp-text {
    font-size: 1rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  .whatsapp-button {
    background-color: var(--primary-green);
    color: var(--color-secondary);
    padding: 0.75rem var(--spacing-md);
    border-radius: var(--border-radius-sm);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-duration) ease;
    display: inline-block;
  }

  .whatsapp-button:hover {
    background-color: var(--primary-green-hover);
  }

  /* Thank you message */
  .thank-you-message {
    margin-top: var(--spacing-lg);
    font-size: 1.1rem;
    color: var(--primary-green);
    font-weight: 600;
  }
</style>
