---
import { MessageCircle, Truck, Sparkles, PackageCheck } from 'lucide-astro';

const steps = [
  {
    number: "01",
    icon: MessageCircle,
    title: "Agenda por WhatsApp",
    description: "Escríbenos con fotos de tus zapatillas. Te damos presupuesto inmediato y coordinamos la recogida.",
    highlight: "Respuesta en menos de 1 hora"
  },
  {
    number: "02",
    icon: Truck,
    title: "Recogida gratis",
    description: "Pasamos por tu casa u oficina en el horario acordado, sin costo adicional.",
    highlight: "Horarios flexibles"
  },
  {
    number: "03",
    icon: Sparkles,
    title: "Limpieza profesional",
    description: "Aplicamos técnicas especializadas y productos profesionales adaptados a cada material.",
    highlight: "4–7 días de proceso"
  },
  {
    number: "04",
    icon: PackageCheck,
    title: "Entrega a domicilio",
    description: "Te devolvemos tus zapatillas limpias y renovadas. Pagas al recibir, sin sorpresas.",
    highlight: "Inspección antes del pago"
  },
];
---

<section id="about" class="process-section">
  <div class="process-container">
    <div class="section-header">
      <p class="section-label">Cómo funciona</p>
      <h2 class="section-title">Tu calzado renovado<br />en 4 pasos.</h2>
    </div>

    <div class="steps-grid">
      {steps.map((step) => {
        const Icon = step.icon;
        return (
          <div class="step-item">
            <div class="step-top">
              <span class="step-number">{step.number}</span>
              <div class="step-icon">
                <Icon size={22} />
              </div>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
            <span class="step-highlight">{step.highlight}</span>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 8rem 2rem;
    background: #F8F8F8;
  }

  .process-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #999;
    margin: 0 0 1rem 0;
  }

  .section-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    color: #000000;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .step-item {
    display: flex;
    flex-direction: column;
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .step-number {
    font-size: 2rem;
    font-weight: 800;
    color: #000000;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .step-icon {
    width: 44px;
    height: 44px;
    background: #ffffff;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #000000;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.01em;
  }

  .step-description {
    font-size: 0.9375rem;
    color: #666;
    line-height: 1.65;
    margin: 0 0 1.25rem 0;
    flex: 1;
  }

  .step-highlight {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #25D366;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .process-section {
      padding: 5rem 1.5rem;
    }

    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 560px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
