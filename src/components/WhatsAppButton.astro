---
// src/components/WhatsAppButton.astro
const whatsappLink = "https://wa.me/+50764439110?text=Hola%21%20Llegué%20desde%20la%20web%20myshusla.com%20(botón%20flotante)%20y%20quiero%20información%20sobre%20limpieza%20de%20zapatillas";
---

<a
  href={whatsappLink}
  class="whatsapp-float"
  target="_blank"
  aria-label="Chatea con nosotros por WhatsApp"
  data-track="whatsapp-float"
>
  <img src="/images/whatsapp-icon.png" alt="WhatsApp" width="50" height="50" loading="lazy" />
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: auto;
    height: auto;
    z-index: 1000;
    transition: transform 0.2s ease-in-out, opacity 0.2s ease-in-out;
  }

  .whatsapp-float img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  .whatsapp-float:hover {
    transform: scale(1.1);
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      bottom: 80px; /* Avoid overlap with mobile UI */
    }
    
    .whatsapp-float img {
      width: 45px;
      height: 45px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
    
    .whatsapp-float:hover {
      transform: none;
    }
  }
</style> 