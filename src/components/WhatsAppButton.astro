---
import { MessageCircle } from 'lucide-astro';
import { siteConfig } from '../config';

const whatsappLink = siteConfig.whatsappLinks.float;
---

<a
  href={whatsappLink}
  class="whatsapp-float"
  target="_blank"
  aria-label="Chatea con nosotros por WhatsApp"
  data-track="whatsapp-float"
>
  <MessageCircle size={28} />
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 60px;
    height: 60px;
    background: var(--gradient-olive);
    color: var(--color-secondary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    box-shadow: var(--shadow-lg);
    transition: all var(--transition-fast) var(--transition-easing);
  }

  .whatsapp-float:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: var(--shadow-xl);
  }

  .whatsapp-float:active {
    transform: translateY(-2px) scale(1.02);
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      bottom: 80px;
      width: 56px;
      height: 56px;
    }

    .whatsapp-float :global(svg) {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }

    .whatsapp-float:hover {
      transform: none;
    }
  }
</style>
