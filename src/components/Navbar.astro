---
import { Menu, X } from 'lucide-astro';
import { siteConfig } from '../config';

const whatsappLink = siteConfig.whatsappLinks.header;

const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#precios', label: 'Precios' },
  { href: '/#resenas', label: 'Reseñas' },
  { href: '/#faq', label: 'FAQ' },
];
---

<nav class="nav" aria-label="Navegación principal">
  <div class="nav-row">
    <a href="/" class="nav-logo" aria-label="MyShus — Inicio">
      <img src="/images/myshus-logo-dark.png" alt="MyShus" width="180" height="30" loading="eager" />
    </a>

    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={whatsappLink} class="nav-cta" target="_blank" rel="noopener" data-wa-source="navbar">
        WhatsApp
      </a>
    </div>

    <button class="nav-burger" aria-label="Menú" aria-expanded="false" aria-controls="nav-menu">
      <Menu class="i-menu" size={24} />
      <X class="i-close" size={24} />
    </button>
  </div>

  <div class="nav-menu" id="nav-menu">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={whatsappLink} class="menu-cta" target="_blank" rel="noopener" data-wa-source="navbar-mobile">
      Agenda por WhatsApp
    </a>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burger = document.querySelector('.nav-burger');
    const menu = document.querySelector('.nav-menu');
    const nav = document.querySelector('.nav');
    if (!burger || !menu) return;

    const close = () => {
      burger.setAttribute('aria-expanded', 'false');
      menu.classList.remove('open');
      document.body.style.overflow = 'auto';
    };

    burger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', (!open).toString());
      menu.classList.toggle('open');
      document.body.style.overflow = open ? 'auto' : 'hidden';
    });

    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('.nav') && menu.classList.contains('open')) close();
    });

    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 16);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(244, 241, 233, 0.72);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .nav.scrolled {
    border-bottom-color: var(--line);
    background: rgba(244, 241, 233, 0.88);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: var(--navbar-height);
  }

  .nav-logo img {
    height: 30px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    transition: opacity 0.15s ease;
  }

  .nav-links a:not(.nav-cta):hover {
    opacity: 0.55;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.15rem;
    background: var(--ink);
    color: var(--bg) !important;
    border-radius: 999px;
    font-weight: 600 !important;
    font-size: 0.875rem !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }

  .nav-cta:hover {
    opacity: 1 !important;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .nav-burger {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: var(--ink);
  }

  .i-close { display: none; }
  [aria-expanded='true'] .i-menu { display: none; }
  [aria-expanded='true'] .i-close { display: block; }

  .nav-menu { display: none; }

  @media (max-width: 820px) {
    .nav-links { display: none; }
    .nav-burger { display: flex; align-items: center; }

    .nav-menu {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--navbar-height);
      left: 0;
      right: 0;
      background: var(--bg);
      transform: translateY(-110%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.32s var(--transition-easing), opacity 0.32s ease, visibility 0.32s;
      padding: 1rem 1.5rem 2rem;
      box-shadow: var(--shadow-lg);
      border-bottom: 1px solid var(--line);
      z-index: 999;
    }

    .nav-menu.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-menu a {
      text-decoration: none;
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--ink);
      padding: 1.05rem 0;
      border-bottom: 1px solid var(--line);
    }

    .menu-cta {
      margin-top: 1.25rem;
      text-align: center;
      padding: 1rem !important;
      background: var(--ink);
      color: var(--bg) !important;
      border-radius: 999px;
      font-weight: 600 !important;
      border-bottom: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav-menu, .nav-cta { transition: none; }
  }
</style>
