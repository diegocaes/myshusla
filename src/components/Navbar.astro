---
import { Menu, X } from 'lucide-astro';
---

<meta charset="UTF-8" />
<nav class="navbar" aria-label="Navegación principal">
  <div class="navbar-container">
    <div class="navbar-left">
      <a href="/" role="menuitem">Inicio</a>
      <a href="#services" role="menuitem">Servicios</a>
      <a href="/store" role="menuitem">Tienda</a>
    </div>

    <div class="navbar-logo">
      <a href="/" aria-label="MyShus - Ir a Inicio">
        <img
          src="/images/myshus-logo-hori.png"
          alt="MyShus Logo"
          width="140"
          height="47"
          loading="eager"
        />
      </a>
    </div>

    <div class="navbar-right">
      <a href="/tips" role="menuitem">Tips</a>
      <a href="#contact" role="menuitem">Contacto</a>
    </div>

    <button class="mobile-menu-btn" aria-label="Menú" aria-expanded="false" aria-controls="navbar-menu">
      <Menu class="icon-menu" size={24} />
      <X class="icon-close" size={24} />
    </button>
  </div>

  <div class="mobile-menu" id="navbar-menu">
    <a href="/" role="menuitem">Inicio</a>
    <a href="#services" role="menuitem">Servicios</a>
    <a href="/store" role="menuitem">Tienda</a>
    <a href="/tips" role="menuitem">Tips</a>
    <a href="#contact" role="menuitem">Contacto</a>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.querySelector('.mobile-menu-btn');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-menu a');

    if (!mobileBtn || !mobileMenu) return;

    // Toggle menu on button click
    mobileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('active');
      document.body.style.overflow = isExpanded ? 'auto' : 'hidden';
    });

    // Close menu when clicking on any link
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('active');
        document.body.style.overflow = 'auto';
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.navbar') && mobileMenu.classList.contains('active')) {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    });
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--navbar-bg);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border-bottom: 1px solid var(--navbar-border);
  }

  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
    height: var(--navbar-height);
  }

  .navbar-left,
  .navbar-right {
    display: flex;
    gap: var(--spacing-lg);
    flex: 1;
  }

  .navbar-left {
    justify-content: flex-start;
  }

  .navbar-right {
    justify-content: flex-end;
  }

  .navbar-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .navbar-logo img {
    height: 42px;
    width: auto;
    transition: transform var(--transition-fast) var(--transition-easing);
  }

  .navbar-logo:hover img {
    transform: scale(1.03);
  }

  .navbar-left a,
  .navbar-right a {
    text-decoration: none;
    font-family: var(--primary-font);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navbar-text);
    letter-spacing: 0.01em;
    transition: color var(--transition-fast) var(--transition-easing);
    position: relative;
    white-space: nowrap;
  }

  .navbar-left a::after,
  .navbar-right a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--accent-gold);
    transition: width var(--transition-fast) var(--transition-easing);
  }

  .navbar-left a:hover,
  .navbar-right a:hover {
    color: var(--accent-gold);
  }

  .navbar-left a:hover::after,
  .navbar-right a:hover::after {
    width: 100%;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    padding: 12px;
    cursor: pointer;
    color: var(--navbar-text);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    z-index: 1001;
    position: relative;
  }

  .icon-close {
    display: none;
  }

  [aria-expanded="true"] .icon-menu {
    display: none;
  }

  [aria-expanded="true"] .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 968px) {
    .navbar-container {
      padding: 0 var(--spacing-md);
    }

    .navbar-left,
    .navbar-right {
      display: none;
    }

    .navbar-logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
    }

    .mobile-menu {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--navbar-height);
      left: 0;
      right: 0;
      background-color: var(--background-white);
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.3s var(--transition-easing), opacity 0.3s var(--transition-easing), visibility 0.3s;
      padding: var(--spacing-lg) var(--spacing-md);
      gap: var(--spacing-md);
      box-shadow: 0 8px 16px rgba(10, 10, 10, 0.1);
      border-bottom: 1px solid var(--border-color);
      z-index: 999;
      max-height: calc(100vh - var(--navbar-height));
      overflow-y: auto;
    }

    .mobile-menu.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu a {
      text-decoration: none;
      font-family: var(--primary-font);
      font-size: 1.125rem;
      font-weight: 500;
      color: var(--color-text);
      padding: var(--spacing-sm) 0;
      text-align: center;
      transition: color var(--transition-fast) var(--transition-easing);
      border-bottom: 1px solid var(--border-color-light);
    }

    .mobile-menu a:last-child {
      border-bottom: none;
    }

    .mobile-menu a:hover,
    .mobile-menu a:active {
      color: var(--accent-gold);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-logo img,
    .navbar-left a::after,
    .navbar-right a::after,
    .mobile-menu {
      transition: none;
    }
  }
</style>
